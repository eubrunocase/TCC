\newpage{\null\newpage}
%\DEELfichacatalografica     % Obrigatório

\folhaaprovacao         % Obrigatório
\newpage{\null\newpage}
\textodedicatoria       % Opcional
\textoagradecimentos    % Opcional
\textoepigrafe          % Opcional
\textoresumo            % Obrigatório
